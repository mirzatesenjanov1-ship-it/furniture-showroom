datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  SUPERADMIN
}

enum FurnitureStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  SOLD
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  auditLogs AuditLog[]
}

model Category {
  id          String      @id @default(uuid())
  name        String      @unique
  slug        String      @unique
  description String?
  furniture   Furniture[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Furniture {
  id          String          @id @default(uuid())
  title       String
  slug        String          @unique
  price       Decimal         @db.Decimal(12, 2)
  oldPrice    Decimal?        @db.Decimal(12, 2)
  dimensions  String
  material    String
  color       String
  description String          @db.Text
  status      FurnitureStatus @default(DRAFT)
  isPopular   Boolean         @default(false)
  isNew       Boolean         @default(true)
  sku         String          @unique
  categoryId  String
  category    Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  images      FurnitureImage[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([slug])
  @@index([categoryId])
  @@index([status])
}

model FurnitureImage {
  id          String    @id @default(uuid())
  url         String
  isCover     Boolean   @default(false)
  sortOrder   Int       @default(0)
  furnitureId String
  furniture   Furniture @relation(fields: [furnitureId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
}

model Settings {
  id              String   @id @default("global_settings")
  companyName     String   @default("Мебель Шоурум")
  whatsappNumber  String   @default("996706035765")
  phone           String   @default("+996 706 035 765")
  address         String   @default("Бишкек шаары, Манас проспекти 40")
  workingHours    String   @default("09:00 - 19:00 (Дүйшөмбү - Ишемби)")
  instagramUrl    String?
  tiktokUrl       String?
  currency        String   @default("сом")
  updatedAt       DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  details   String?
  ipAddress String?
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}
