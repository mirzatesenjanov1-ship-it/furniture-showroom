datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Admin {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String   // bcrypt аркылуу хэштелген пароль сакталат
  createdAt DateTime @default(now())
}

model Furniture {
  id          String   @id @default(uuid())
  title       String
  description String
  price       Float
  imageUrl    String
  category    String
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
}
